# An allowlist: everything is ignored unless named here.
/*
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/README.md
!/CONTRIBUTING.md
!/AI-CONTRIBUTING.md
!/LICENSE
!/build-dist.sh

!/src/
/src/**
!/src/*.rs

!/assets/
/assets/**
!/assets/*.ttf
!/assets/*.txt
!/assets/*.svg
# The app icon: a blur the SVG renderer cannot draw.
!/assets/maia.png
# The tour's films: built into the binary, made by tools/tour-media.sh.
!/assets/tour/
!/assets/tour/*.webp

!/tools/
/tools/**
!/tools/sim.sh
!/tools/window.sh
!/tools/solar_icons.py
!/tools/notices.py
!/tools/tour-media.sh
!/tools/package.sh
!/tools/labels.sh

# Crates carried with a change of ours, patched in from Cargo.toml (each says why).
!/vendor/
/vendor/**
!/vendor/vello_cpu/
!/vendor/vello_cpu/**
# Its README is upstream's page on crates.io, which nothing here builds from.
/vendor/vello_cpu/README.md

# What the packages install besides the program.
!/packaging/
/packaging/**
!/packaging/*.desktop
!/packaging/*.metainfo.xml

# The workflows, by name, and the issue forms.
!/.github/
/.github/**
!/.github/workflows/
/.github/workflows/**
!/.github/workflows/release.yml
!/.github/workflows/ci.yml
!/.github/workflows/issue-labels.yml
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/*.yml

# The README screenshot, allowed by name once it exists.
!/docs/
/docs/**
!/docs/maia.webp
